{
  "name": "logiai-logistics",
  "version": "4.0.0",
  "private": true,
  "description": "Next-Generation AI-Powered Vietnamese Logistics Management Platform with Advanced Intelligence - Version 4.0",
  "main": "next.config.js",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "serve out",
    "lint": "next lint",
    "export": "next build",
    "docker:fleetbase": "docker-compose -f docker-compose.fleetbase.yml up -d",
    "docker:fleetbase:down": "docker-compose -f docker-compose.fleetbase.yml down",
    "docker:fleetbase:logs": "docker-compose -f docker-compose.fleetbase.yml logs -f",
    "test:optimization": "node test-optimization.mjs",
    "test:fleetbase": "node test-fleetbase-integration.mjs",
    "test:aws": "node test-aws-integration.mjs",
    "test:ai": "node test-ai-features.mjs",
    "test:performance": "node test-performance.mjs",
    "deploy:cloudflare": "./deploy-cloudflare.sh",
    "setup:env": "cp .env.example .env.local",
    "db:migrate": "docker-compose -f docker-compose.fleetbase.yml exec fleetbase-api php artisan migrate",
    "db:seed": "docker-compose -f docker-compose.fleetbase.yml exec fleetbase-api php artisan db:seed",
    "analyze": "cross-env ANALYZE=true next build",
    "type-check": "tsc --noEmit",
    "upgrade": "npm update && npm audit fix",
    "clean": "rm -rf .next out node_modules/.cache",
    "fresh-install": "rm -rf node_modules package-lock.json && npm install"
  },
